# ── FocusFlow configuration ────────────────────────────────────────────────
# Copy to .env (backend/) and/or fill real values. Never commit real secrets.

# AWS credentials for Amazon Bedrock (Option A: keys)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Option B: profile instead of keys
# AWS_PROFILE=my-dev-profile

# Bedrock model id (must be enabled in your account, e.g. in us-east-1)
# Examples: anthropic.claude-sonnet-4-20250514-v1:0
#           us.anthropic.claude-sonnet-4-20250929-v1:0  (cross-region inference profile)
FOCUSFLOW_BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-20250514-v1:0

# Force mock mode even if AWS credentials exist (1 = mock, clearly labeled in UI)
FOCUSFLOW_FORCE_MOCK=0

# SQLite database file (created automatically; demo data seeded when empty)
FOCUSFLOW_DB_PATH=./data/focusflow.db
FOCUSFLOW_SEED_DEMO=1

# Deterministic scheduling window (local time, 24h)
FOCUSFLOW_WORK_START=9
FOCUSFLOW_WORK_END=18
FOCUSFLOW_HORIZON_DAYS=14

# CORS origins allowed to call the API (comma-separated exact matches)
FOCUSFLOW_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
# Regex for dev origins, so opening the UI via a LAN IP (e.g. http://10.10.34.154:3001)
# also works. Default already covers localhost and private 10.x / 192.168.x / 172.16-31.x
# ranges on any port; leave empty to disable. Never use ".*" in production.
FOCUSFLOW_CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|0\.0\.0\.0|10\.\d{1,3}\.\d{1,3}\.\d{1,3}|192\.168\.\d{1,3}\.\d{1,3}|172\.(?:1[6-9]|2\d|3[01])\.\d{1,3}\.\d{1,3})(?::\d{1,5})?$

# Frontend -> backend URL (build-time for Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000

# MCP server bind
FOCUSFLOW_MCP_HOST=127.0.0.1
FOCUSFLOW_MCP_PORT=8001
